# 收尾(physical teardown)只允许触碰非活跃任务;
# pending 虽不在 ACTIVE_TASK_STATUSES 里,但尚未派发,同样禁止销毁。
TEARDOWN_BLOCKING_STATUSES = {*ACTIVE_TASK_STATUSES, "pending"}

